--- /dev/null
+++ b/src/compiler/public_api_hash.rs
@@ -0,0 +1,304 @@
+//! Skips the compilation of libraries whose dependencies changed only in ways that the
+//! library cannot observe (`-Zpublic-api-hash`).
+//!
+//! With `-Zpublic-api-hash`, rustc computes a hash of everything in the metadata of a library
+//! that its dependents can observe, and reports it in the artifact notification of the
+//! metadata file. Cargo saves it in the [`PUBLIC_API_HASH`] file of the unit.
+//!
+//! When a library is dirty only because some of its dependencies were compiled again, Cargo
+//! compares what the library sees of each dependency now with what it saw when it was last
+//! compiled, which is saved in the [`DEP_VIEWS`] file. If nothing changed,
+//! compiling the library again would produce the same outputs, so Cargo marks its outputs as
+//! up to date instead, and replays its cached messages like for a fresh unit. Its own
+//! dependents then go through the same check.
+//!
+//! What a unit sees of a dependency is:
+//!
+//! - for a library compiled with `-Zpublic-api-hash`: its public API hash;
+//! - for a build script run: its output, which can set flags and environment variables. Files
+//!   that the build script writes are tracked in the dep-info of the unit, like its own source
+//!   files;
+//! - for anything else (for example a proc macro): the modification times of its outputs, so
+//!   that a dependency which was compiled again is always seen as changed.
+//!
+//! Only `lib` and `rlib` crates are skipped: other crate types link their dependencies into
+//! their outputs.
+
+use std::fs;
+use std::path::PathBuf;
+
+use cargo_util::paths;
+use serde_json::Value;
+
+use crate::compiler::build_runner::BuildRunner;
+use crate::compiler::custom_build::BuildScriptRunFiles;
+use crate::compiler::fingerprint::{self, DirtyReason, FsStatus};
+use crate::compiler::job_queue::{Freshness, Work};
+use crate::compiler::{CompileMode, CrateType, Unit};
+use crate::util::errors::CargoResult;
+use crate::util::path_args;
+use crate::workspace::PackageId;
+
+/// The public API hash of a library, as reported by rustc.
+pub const PUBLIC_API_HASH: &str = "public-api-hash";
+
+/// What a library saw of each of its dependencies when it was last compiled, as a JSON array
+/// with one string per dependency.
+pub const DEP_VIEWS: &str = "public-api-hash-deps";
+
+/// The path where the public API hash that rustc reports for `unit` is saved.
+pub fn public_api_hash_path(build_runner: &BuildRunner<'_, '_>, unit: &Unit) -> PathBuf {
+    build_runner
+        .files()
+        .fingerprint_dir(unit)
+        .join(PUBLIC_API_HASH)
+}
+
+/// Skips the work that compiles a unit when only its dependencies changed, and none of them
+/// in a way that the unit can observe.
+pub struct SkipIfUnchanged {
+    package_id: PackageId,
+    may_skip: bool,
+    deps: Vec<DepView>,
+    outputs: Vec<PathBuf>,
+    /// Where rustc's report of the unit's own public API hash is saved.
+    public_api_hash: PathBuf,
+    /// Where what the unit saw of its dependencies when it was last compiled is saved.
+    dep_views: PathBuf,
+    cache_path: PathBuf,
+    /// The message cache of the unit, which preparing its work removes.
+    cache: Option<String>,
+    replay: Work,
+}
+
+impl SkipIfUnchanged {
+    /// Returns `None` without `-Zpublic-api-hash`.
+    ///
+    /// Must be called before the work that compiles `unit` is prepared: preparing it removes
+    /// the message cache of the unit, which a skipped unit still needs.
+    pub fn new(
+        build_runner: &BuildRunner<'_, '_>,
+        unit: &Unit,
+        freshness: &Freshness,
+    ) -> CargoResult<Option<Self>> {
+        if !build_runner.bcx.gctx.cli_unstable().public_api_hash {
+            return Ok(None);
+        }
+        let files = build_runner.files();
+        let deps = build_runner
+            .unit_deps(unit)
+            .iter()
+            .map(|dep| {
+                let view = if dep.unit.mode.is_run_custom_build() {
+                    BuildScriptRunFiles::for_unit(build_runner, &dep.unit).stdout
+                } else {
+                    public_api_hash_path(build_runner, &dep.unit)
+                };
+                Ok(DepView {
+                    view,
+                    outputs: output_paths(build_runner, &dep.unit)?,
+                })
+            })
+            .collect::<CargoResult<Vec<_>>>()?;
+        let cache_path = files.message_cache_path(unit);
+        let cache = fs::read_to_string(&cache_path).ok();
+        let may_skip = only_dependencies_changed(freshness)
+            && is_rlib(unit)
+            && match &cache {
+                Some(cache) => cached_diagnostics_are_current(build_runner, unit, cache)?,
+                None => true,
+            };
+        let replay = super::replay_output_cache(
+            unit.pkg.package_id(),
+            super::ManifestErrorContext::new(build_runner, unit),
+            &unit.target,
+            cache_path.clone(),
+            super::OutputOptions::for_fresh(build_runner, unit),
+        );
+        Ok(Some(SkipIfUnchanged {
+            package_id: unit.pkg.package_id(),
+            may_skip,
+            deps,
+            outputs: output_paths(build_runner, unit)?,
+            public_api_hash: public_api_hash_path(build_runner, unit),
+            dep_views: files.fingerprint_dir(unit).join(DEP_VIEWS),
+            cache_path,
+            cache,
+            replay,
+        }))
+    }
+
+    /// Wraps `work`, which compiles the unit.
+    pub fn wrap(self, work: Work) -> Work {
+        Work::new(move |state| {
+            // The dependencies have been compiled by now, so what they show is current.
+            let current = self
+                .deps
+                .iter()
+                .map(DepView::read)
+                .collect::<Option<Vec<_>>>()
+                .map(|views| serde_json::to_string(&views))
+                .transpose()?;
+            if self.may_skip
+                && current.is_some()
+                && current == fs::read_to_string(&self.dep_views).ok()
+            {
+                tracing::debug!(
+                    "skipping {}: no dependency changed in a way it can observe",
+                    self.package_id
+                );
+                let now = filetime::FileTime::now();
+                for output in &self.outputs {
+                    paths::set_file_time_no_err(output, now);
+                }
+                if let Some(cache) = &self.cache {
+                    paths::write(&self.cache_path, cache)?;
+                }
+                return self.replay.call(state);
+            }
+            // rustc reports a new hash, if the unit has one.
+            let _ = fs::remove_file(&self.public_api_hash);
+            match current {
+                Some(views) => paths::write(&self.dep_views, views)?,
+                None => {
+                    let _ = fs::remove_file(&self.dep_views);
+                }
+            }
+            work.call(state)
+        })
+    }
+}
+
+fn output_paths(build_runner: &BuildRunner<'_, '_>, unit: &Unit) -> CargoResult<Vec<PathBuf>> {
+    Ok(build_runner
+        .outputs(unit)?
+        .iter()
+        .map(|o| o.path.clone())
+        .collect())
+}
+
+/// What a unit sees of one of its dependencies, see the module documentation.
+struct DepView {
+    /// The public API hash of the dependency, or the output of a build script run.
+    view: PathBuf,
+    /// Outputs of the dependency, whose modification times stand in for `view` when it does
+    /// not exist.
+    outputs: Vec<PathBuf>,
+}
+
+impl DepView {
+    fn read(&self) -> Option<String> {
+        fs::read_to_string(&self.view).ok().or_else(|| {
+            // Some outputs are optional, for example split debug info.
+            let mtimes: Vec<_> = self
+                .outputs
+                .iter()
+                .filter_map(|o| paths::mtime(o).ok())
+                .collect();
+            (!mtimes.is_empty()).then(|| format!("{mtimes:?}"))
+        })
+    }
+}
+
+/// Whether the unit is dirty only because a dependency changed. With `-Zpublic-api-hash`, the
+/// unit's own files are checked before its dependencies, so a stale dependency means that they
+/// are up to date.
+fn only_dependencies_changed(freshness: &Freshness) -> bool {
+    matches!(
+        freshness,
+        Freshness::Dirty(DirtyReason::FsStatusOutdated(
+            FsStatus::StaleDepFingerprint { .. } | FsStatus::StaleDependency { .. }
+        ))
+    )
+}
+
+/// Whether the outputs of the unit contain nothing of its dependencies but their metadata.
+fn is_rlib(unit: &Unit) -> bool {
+    (unit.mode == CompileMode::Build || unit.mode.is_check())
+        && unit.target.is_lib()
+        && unit
+            .target
+            .rustc_crate_types()
+            .iter()
+            .all(|t| matches!(t, CrateType::Lib | CrateType::Rlib))
+}
+
+/// Whether the cached diagnostics of `unit` (the content of its message cache) are the ones
+/// that compiling it again would produce. The public API hash of a dependency leaves out
+/// positions that dependents only use in diagnostics, so a diagnostic that points into a
+/// dependency could be out of date. Every file that a diagnostic points to, in its spans, the
+/// spans of its children, and macro expansions, must therefore be one of the unit's own source
+/// files, which are up to date, or a file of the toolchain.
+///
+/// This is conservative: a file that cannot be placed, or a cache or dep-info that cannot be
+/// read, means that the unit is compiled again.
+fn cached_diagnostics_are_current(
+    build_runner: &BuildRunner<'_, '_>,
+    unit: &Unit,
+    cache: &str,
+) -> CargoResult<bool> {
+    if !cache.contains(r#""$message_type":"diagnostic""#) {
+        return Ok(true);
+    }
+    let build_root = build_runner.bcx.ws.build_dir().into_path_unlocked();
+    let dep_info_path = build_runner.files().fingerprint_file_path(unit, "dep-");
+    let Some(dep_info) = fingerprint::parse_dep_info(unit.pkg.root(), &build_root, &dep_info_path)?
+    else {
+        return Ok(false);
+    };
+    // rustc writes file names relative to its working directory.
+    let cwd = path_args(build_runner.bcx.ws, unit).1;
+    let sysroot = &build_runner.bcx.target_data.info(unit.kind).sysroot;
+    let is_current = |file_name: &str| {
+        let path = cwd.join(file_name);
+        // `/rustc/<commit hash>/` is the remapped path of the standard library sources.
+        dep_info.files.contains_key(&path)
+            || path.starts_with(sysroot)
+            || file_name.starts_with("/rustc/")
+    };
+    for line in cache.lines() {
+        let Ok(message) = serde_json::from_str::<Value>(line) else {
+            return Ok(false);
+        };
+        let is_diagnostic =
+            message.get("$message_type").and_then(Value::as_str) == Some("diagnostic");
+        if is_diagnostic && !all_file_names(&message, &is_current) {
+            return Ok(false);
+        }
+    }
+    Ok(true)
+}
+
+/// Whether `f` holds for every `file_name` string anywhere in `value`.
+fn all_file_names(value: &Value, f: &impl Fn(&str) -> bool) -> bool {
+    match value {
+        Value::Object(map) => map.iter().all(|(key, value)| match (key.as_str(), value) {
+            ("file_name", Value::String(name)) => f(name),
+            _ => all_file_names(value, f),
+        }),
+        Value::Array(items) => items.iter().all(|item| all_file_names(item, f)),
+        _ => true,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::all_file_names;
+
+    #[test]
+    fn file_names_in_children_and_expansions() {
+        let message = serde_json::json!({
+            "$message_type": "diagnostic",
+            "spans": [{
+                "file_name": "src/lib.rs",
+                "expansion": { "span": { "file_name": "src/lib.rs" }, "def_site_span": { "file_name": "../dep/src/lib.rs" } }
+            }],
+            "children": [{ "spans": [{ "file_name": "src/lib.rs" }] }]
+        });
+        assert!(all_file_names(&message, &|name| name.ends_with(".rs")));
+        assert!(!all_file_names(&message, &|name| name == "src/lib.rs"));
+        assert!(all_file_names(&serde_json::json!({ "spans": [] }), &|_| {
+            false
+        }));
+    }
+}
