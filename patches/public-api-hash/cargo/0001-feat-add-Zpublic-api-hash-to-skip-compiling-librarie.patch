diff --git a/tests/testsuite/public_api_hash.rs b/tests/testsuite/public_api_hash.rs
new file mode 100644
index 00000000..cd6b080c
--- /dev/null
+++ b/tests/testsuite/public_api_hash.rs
@@ -0,0 +1,223 @@
+//! Tests for `-Zpublic-api-hash`, which skips compiling a library again when its
+//! dependencies changed only in ways it cannot observe.
+
+use crate::prelude::*;
+use cargo_test_support::{Project, basic_manifest, project, str};
+
+/// A workspace where `foo` (a library and a binary) depends on the library `bar`.
+fn foo_and_bar(foo_lib: &str, bar_lib: &str) -> Project {
+    project()
+        .file(
+            "Cargo.toml",
+            r#"
+                [package]
+                name = "foo"
+                version = "0.0.1"
+                edition = "2015"
+
+                [dependencies]
+                bar = { path = "bar" }
+            "#,
+        )
+        .file("src/lib.rs", foo_lib)
+        .file("src/main.rs", "fn main() { println!(\"{}\", foo::get()); }")
+        .file("bar/Cargo.toml", &basic_manifest("bar", "0.0.1"))
+        .file("bar/src/lib.rs", bar_lib)
+        .build()
+}
+
+fn build(p: &Project) -> cargo_test_support::Execs {
+    let mut execs = p.cargo("build -v -Zpublic-api-hash");
+    execs.masquerade_as_nightly_cargo(&["public-api-hash"]);
+    execs
+}
+
+#[cargo_test]
+fn requires_nightly() {
+    let p = project().file("src/lib.rs", "").build();
+    p.cargo("build -Zpublic-api-hash")
+        .with_stderr_data(str![[r#"
+[ERROR] the `-Z` flag is only accepted on the nightly channel of Cargo, but this is the `stable` channel
+See https://doc.rust-lang.org/book/appendix-07-nightly-rust.html for more information about Rust release channels.
+
+"#]])
+        .with_status(101)
+        .run();
+}
+
+#[cargo_test(nightly, reason = "-Zpublic-api-hash is unstable")]
+fn body_change_skips_dependent_library() {
+    let p = foo_and_bar(
+        "pub fn get() -> u32 { bar::value() }",
+        "pub fn value() -> u32 { 1 }",
+    );
+    build(&p).run();
+
+    p.change_file("bar/src/lib.rs", "pub fn value() -> u32 { 2 }");
+    build(&p)
+        .with_stderr_contains("[RUNNING] `rustc --crate-name bar [..]")
+        .with_stderr_contains("[RUNNING] `rustc --crate-name foo [..]--crate-type bin [..]")
+        .with_stderr_does_not_contain("[RUNNING] `rustc --crate-name foo [..]--crate-type lib [..]")
+        .run();
+    p.process(&p.bin("foo"))
+        .with_stdout_data(str![[r#"
+2
+
+"#]])
+        .run();
+
+    // The skipped library is fresh afterwards.
+    build(&p)
+        .with_stderr_contains("[FRESH] foo v0.0.1 ([ROOT]/foo)")
+        .with_stderr_does_not_contain("[RUNNING] `rustc [..]")
+        .run();
+}
+
+#[cargo_test(nightly, reason = "-Zpublic-api-hash is unstable")]
+fn moved_item_skips_dependent_library() {
+    let p = foo_and_bar(
+        "pub fn get() -> u32 { bar::value() }",
+        "pub fn value() -> u32 { 1 }",
+    );
+    build(&p).run();
+
+    p.change_file("bar/src/lib.rs", "\n\npub fn value() -> u32 { 1 }");
+    build(&p)
+        .with_stderr_contains("[RUNNING] `rustc --crate-name bar [..]")
+        .with_stderr_does_not_contain("[RUNNING] `rustc --crate-name foo [..]--crate-type lib [..]")
+        .run();
+}
+
+#[cargo_test(nightly, reason = "-Zpublic-api-hash is unstable")]
+fn public_api_change_compiles_dependent_library() {
+    let p = foo_and_bar(
+        "pub fn get() -> u32 { bar::value() }",
+        "pub fn value() -> u32 { 1 }",
+    );
+    build(&p).run();
+
+    // Generic and inline functions are part of the public API: dependents compile them.
+    p.change_file("bar/src/lib.rs", "#[inline] pub fn value() -> u32 { 1 }");
+    build(&p)
+        .with_stderr_contains("[RUNNING] `rustc --crate-name foo [..]--crate-type lib [..]")
+        .run();
+
+    p.change_file("bar/src/lib.rs", "#[inline] pub fn value() -> u32 { 3 }");
+    build(&p)
+        .with_stderr_contains("[RUNNING] `rustc --crate-name foo [..]--crate-type lib [..]")
+        .run();
+    p.process(&p.bin("foo"))
+        .with_stdout_data(str![[r#"
+3
+
+"#]])
+        .run();
+}
+
+#[cargo_test(nightly, reason = "-Zpublic-api-hash is unstable")]
+fn without_flag_compiles_dependent_library() {
+    let p = foo_and_bar(
+        "pub fn get() -> u32 { bar::value() }",
+        "pub fn value() -> u32 { 1 }",
+    );
+    p.cargo("build -v").run();
+
+    p.change_file("bar/src/lib.rs", "pub fn value() -> u32 { 2 }");
+    p.cargo("build -v")
+        .with_stderr_contains("[RUNNING] `rustc --crate-name foo [..]--crate-type lib [..]")
+        .run();
+}
+
+#[cargo_test(nightly, reason = "-Zpublic-api-hash is unstable")]
+fn skipped_library_shows_its_cached_warnings() {
+    let p = foo_and_bar(
+        "pub fn get() -> u32 { let unused = 1; bar::value() }",
+        "pub fn value() -> u32 { 1 }",
+    );
+    build(&p).run();
+
+    p.change_file("bar/src/lib.rs", "pub fn value() -> u32 { 2 }");
+    build(&p)
+        .with_stderr_does_not_contain("[RUNNING] `rustc --crate-name foo [..]--crate-type lib [..]")
+        .with_stderr_contains("[WARNING] unused variable: `unused`")
+        .run();
+    // The cached warnings are kept for the next build.
+    build(&p)
+        .with_stderr_contains("[WARNING] unused variable: `unused`")
+        .run();
+}
+
+#[cargo_test(nightly, reason = "-Zpublic-api-hash is unstable")]
+fn warning_pointing_into_dependency_compiles_dependent_library() {
+    // The deprecation warning in `foo` comes from a macro defined in `bar`, so it points into
+    // `bar`, whose positions the public API hash leaves out.
+    let p = foo_and_bar(
+        "pub fn get() -> u32 { bar::call_old!() }",
+        r#"
+            #[macro_export]
+            macro_rules! call_old { () => { $crate::old() }; }
+            #[deprecated]
+            pub fn old() -> u32 { 1 }
+            pub fn other() -> u32 { 1 }
+        "#,
+    );
+    build(&p)
+        .with_stderr_contains("[WARNING] use of deprecated function `bar::old`")
+        .run();
+
+    p.change_file(
+        "bar/src/lib.rs",
+        r#"
+            #[macro_export]
+            macro_rules! call_old { () => { $crate::old() }; }
+            #[deprecated]
+            pub fn old() -> u32 { 1 }
+            pub fn other() -> u32 { 2 }
+        "#,
+    );
+    build(&p)
+        .with_stderr_contains("[RUNNING] `rustc --crate-name foo [..]--crate-type lib [..]")
+        .with_stderr_contains("[WARNING] use of deprecated function `bar::old`")
+        .run();
+}
+
+#[cargo_test(nightly, reason = "-Zpublic-api-hash is unstable")]
+fn build_script_output_change_compiles_dependent_library() {
+    let p = project()
+        .file(
+            "Cargo.toml",
+            r#"
+                [package]
+                name = "foo"
+                version = "0.0.1"
+                edition = "2015"
+                build = "build.rs"
+
+                [dependencies]
+                bar = { path = "bar" }
+            "#,
+        )
+        .file(
+            "src/lib.rs",
+            "pub fn get() -> &'static str { env!(\"FOO_VALUE\") }",
+        )
+        .file(
+            "build.rs",
+            r#"
+                fn main() {
+                    println!("cargo::rerun-if-env-changed=FOO_VALUE_SOURCE");
+                    let value = std::env::var("FOO_VALUE_SOURCE").unwrap_or_default();
+                    println!("cargo::rustc-env=FOO_VALUE={value}");
+                }
+            "#,
+        )
+        .file("bar/Cargo.toml", &basic_manifest("bar", "0.0.1"))
+        .file("bar/src/lib.rs", "")
+        .build();
+    build(&p).env("FOO_VALUE_SOURCE", "a").run();
+
+    build(&p)
+        .env("FOO_VALUE_SOURCE", "b")
+        .with_stderr_contains("[RUNNING] `rustc --crate-name foo [..]--crate-type lib [..]")
+        .run();
+}
