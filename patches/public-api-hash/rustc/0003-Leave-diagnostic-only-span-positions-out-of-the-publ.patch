+/// Whether downstream crates can put the position of this definition's span into machine code: the
+/// debug info of code they generate for it, from its MIR or as a shim. Every other downstream use of
+/// `def_span` is a diagnostic.
+fn def_span_reaches_codegen(tcx: TyCtxt<'_>, def_id: LocalDefId, def_kind: DefKind) -> bool {
+    // A crate built without codegen, such as by `cargo check`, only provides metadata, and its
+    // dependents are built without codegen too.
+    if !tcx.sess.opts.output_types.should_codegen() {
+        return false;
+    }
+    if tcx.sess.opts.unstable_opts.debug_info_type_line_numbers
+        || tcx.sess.is_sanitizer_kcfi_enabled()
+    {
+        return true;
+    }
+    match def_kind {
+        DefKind::Ctor(_, CtorKind::Fn) | DefKind::SyntheticCoroutineBody => true,
+        DefKind::Fn | DefKind::AssocFn | DefKind::Closure => {
+            should_encode_mir(tcx, tcx.reachable_set(()), def_id).1
+                // Reify shims for function pointers.
+                || tcx.codegen_fn_attrs(def_id).flags.contains(CodegenFnAttrFlags::TRACK_CALLER)
+                // Vtable shims, and reify shims for virtual calls.
+                || tcx.def_kind(tcx.local_parent(def_id)) == DefKind::Trait
+        }
+        // Thread local shims.
+        DefKind::Static { .. } => {
+            tcx.codegen_fn_attrs(def_id).flags.contains(CodegenFnAttrFlags::THREAD_LOCAL)
+        }
+        _ => false,
+    }
+}
+
+/// Const evaluation in downstream crates turns span positions of this body into values only
+/// through the `caller_location` intrinsic, which `#[track_caller]` functions such as
+/// `Location::caller()` call; otherwise the positions only show up in diagnostics. Calls of
+/// trait methods or of unknown functions may reach such a function.
+fn ctfe_may_use_caller_location(tcx: TyCtxt<'_>, body: &mir::Body<'_>) -> bool {
+    body.basic_blocks.iter().any(|block| match &block.terminator().kind {
+        mir::TerminatorKind::Call { func, .. } | mir::TerminatorKind::TailCall { func, .. } => {
+            func.const_fn_def().is_none_or(|(def_id, _)| {
+                tcx.trait_of_assoc(def_id).is_some()
+                    || tcx.codegen_fn_attrs(def_id).flags.contains(CodegenFnAttrFlags::TRACK_CALLER)
+                    || tcx.intrinsic(def_id).is_some_and(|i| i.name == sym::caller_location)
+            })
+        }
+        _ => false,
+    })
+}
