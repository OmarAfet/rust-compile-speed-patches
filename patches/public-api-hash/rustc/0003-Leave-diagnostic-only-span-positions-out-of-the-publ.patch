diff --git a/tests/run-make/rdr-public-hash-moved-items/rmake.rs b/tests/run-make/rdr-public-hash-moved-items/rmake.rs
new file mode 100644
index 000000000..5aad40bfe
--- /dev/null
+++ b/tests/run-make/rdr-public-hash-moved-items/rmake.rs
@@ -0,0 +1,72 @@
+// Moving public items to other lines must not change a crate's *public API hash* when downstream
+// crates can only see their positions in diagnostics, but must change it when downstream crates can
+// generate code from the moved items: then the positions end up in their debug info.
+//
+// Like `rdr-public-hash-private-end-of-file-change`, this test rewrites the source file between
+// compilations: the incremental `rdr` tests cannot move an item without also changing the `cfg`
+// attributes that are kept in the metadata.
+
+//@ ignore-cross-compile
+
+use run_make_support::{rfs, rustc};
+
+/// Compile `dep.rs` with debug info and public api hashing, and return its public hash. With
+/// `check`, only metadata is emitted, as for `cargo check`.
+fn compile_and_read_public_hash(check: bool) -> String {
+    let mut cmd = rustc();
+    cmd.input("dep.rs").arg("-Zpublic-api-hash").arg("-g");
+    if check {
+        cmd.emit("metadata");
+    }
+    cmd.run();
+
+    let file = if check { "libdep.rmeta" } else { "libdep.rlib" };
+    let listing = rustc().arg("-Zls=public_hash").input(file).run().stdout_utf8();
+
+    listing
+        .lines()
+        .find_map(|line| line.strip_prefix("Public hash:"))
+        .map(|hash| hash.trim().to_owned())
+        .expect("`-Zls=public_hash` did not print a `Public hash:` line")
+}
+
+/// Insert `line` into `dep.rs` before the first line that starts with `before`.
+fn insert_before(before: &str, line: &str) {
+    let contents = rfs::read_to_string("dep.rs");
+    let at = contents.find(before).expect("anchor line not found");
+    rfs::write("dep.rs", format!("{}{line}\n{}", &contents[..at], &contents[at..]));
+}
+
+fn main() {
+    let baseline = compile_and_read_public_hash(false);
+
+    // Moves every item below `generic`, and none of them can be instantiated downstream (the const
+    // fn `make` is only evaluated there).
+    insert_before("pub fn plain", "// A new line.");
+    let after_top_line = compile_and_read_public_hash(false);
+    assert_eq!(baseline, after_top_line, "public hash changed after moving plain items");
+
+    // A longer private body above public items.
+    insert_before("    2\n}", "    let _unused = 0;");
+    let after_private_body = compile_and_read_public_hash(false);
+    assert_eq!(baseline, after_private_body, "public hash changed after a private body edit");
+
+    // Downstream crates instantiate `generic`, so its position is in their debug info.
+    let check_baseline = compile_and_read_public_hash(true);
+    insert_before("pub fn generic", "// Moves `generic`.");
+    let after_generic_moved = compile_and_read_public_hash(false);
+    assert_ne!(baseline, after_generic_moved, "public hash did not change after moving `generic`");
+
+    // Without codegen, no downstream crate generates code from `generic`.
+    let check_after_generic_moved = compile_and_read_public_hash(true);
+    assert_eq!(check_baseline, check_after_generic_moved, "check-mode hash changed after a move");
+
+    // Const evaluation in downstream crates turns the position of the call to
+    // `Location::caller()` in `located` into a value.
+    insert_before("pub const fn located", "// Moves `located`.");
+    let check_after_located_moved = compile_and_read_public_hash(true);
+    assert_ne!(
+        check_baseline, check_after_located_moved,
+        "hash did not change after moving `located`"
+    );
+}
