+    fn with_ignored_span_positions<'h, H: PublicApiHashState<'h>, T>(
+        &mut self,
+        ignore: bool,
+        hcx: &mut H,
+        f: impl FnOnce(&mut Self, &mut H) -> T,
+    ) -> T {
+        let previous = self.ignore_span_positions;
+        self.ignore_span_positions |= ignore;
+        hcx.hcx_mut().set_ignore_span_positions(self.ignore_span_positions);
