index 0513c9083..4beaddfa9 100644
--- a/compiler/rustc_data_structures/src/stable_hash.rs
+++ b/compiler/rustc_data_structures/src/stable_hash.rs
@@ -35,6 +35,10 @@ pub trait StableHashCtxt {
     /// Assert that the provided `StableHashCtxt` is configured with the default
     /// `StableHashControls`. We should always have bailed out before getting to here with a
     fn assert_default_stable_hash_controls(&self, msg: &str);
+
+    /// With `-Zpublic-api-hash`, expansion hashes leave out span positions, so that moving a macro
+    /// call does not change the hashes of the code it generates.
+    fn ignore_span_positions_for_expansion_hash(&mut self) {}
 }
 
