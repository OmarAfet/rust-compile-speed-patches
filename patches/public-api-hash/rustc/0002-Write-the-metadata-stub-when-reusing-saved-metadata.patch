From 46d5acd2c874bd3ea36b97f6ac17ddce9f554a17 Mon Sep 17 00:00:00 2001
From: OmarAfet <135471287+OmarAfet@users.noreply.github.com>
Date: Mon, 9 Nov 2026 21:55:09 +0300
Subject: [PATCH 2/5] Write the metadata stub when reusing saved metadata

Backport of the current master behaviour, together with its test `tests/run-make/metadata-stub-incremental-reuse`: with `-Zembed-metadata=no`, rustc writes a stub with only the crate header next to the full metadata. When the metadata dep-node is green, `encode_metadata` reuses the saved metadata and returned before writing the stub, so loading the encoded metadata failed with "failed to create encoded metadata from file". Cargo passes `-Zembed-metadata=no` on nightly, so every incremental rebuild that reused metadata failed.

The stub header carries the crate hashes on this branch, so they are read from the header of the saved metadata.
---
 compiler/rustc_metadata/src/rmeta/encoder.rs  | 26 +++++++++++++++
 .../metadata-stub-incremental-reuse/foo.rs    |  3 ++
 .../metadata-stub-incremental-reuse/rmake.rs  | 33 +++++++++++++++++++
 3 files changed, 62 insertions(+)
 create mode 100644 tests/run-make/metadata-stub-incremental-reuse/foo.rs
 create mode 100644 tests/run-make/metadata-stub-incremental-reuse/rmake.rs

diff --git a/compiler/rustc_metadata/src/rmeta/encoder.rs b/compiler/rustc_metadata/src/rmeta/encoder.rs
index 83bc3ffb5..6f292accb 100644
--- a/compiler/rustc_metadata/src/rmeta/encoder.rs
+++ b/compiler/rustc_metadata/src/rmeta/encoder.rs
@@ -4,12 +4,14 @@
 use std::collections::hash_map::Entry;
 use std::fs::File;
 use std::io::{Read, Seek, Write};
+use std::ops::Deref;
 use std::path::{Path, PathBuf};
 use std::sync::Arc;
 
 use rustc_data_structures::fingerprint::Fingerprint;
 use rustc_data_structures::fx::{FxIndexMap, FxIndexSet};
 use rustc_data_structures::memmap::{Mmap, MmapMut};
+use rustc_data_structures::owned_slice::slice_owned;
 use rustc_data_structures::sync::{par_for_each_in, par_join};
 use rustc_data_structures::temp_dir::MaybeTempDir;
 use rustc_data_structures::thousands::usize_with_underscores;
@@ -3120,6 +3122,30 @@ pub fn encode_metadata(tcx: TyCtxt<'_>, path: &Path, ref_path: Option<&Path>) {
             Ok(_) => {}
             Err(err) => tcx.dcx().emit_fatal(FailCreateFileEncoder { err }),
         };
+
+        // Generate the metadata stub manually, as that is a small file compared to full metadata.
+        // Its header needs the hashes from the header of the saved metadata.
+        if let Some(ref_path) = ref_path {
+            let _prof_timer = tcx.prof.verbose_generic_activity("generate_crate_metadata_stub");
+            let file = std::fs::File::open(&source_file_in_incr_dir)
+                .unwrap_or_else(|err| tcx.dcx().emit_fatal(FailCreateFileEncoder { err }));
+            // SAFETY: nothing modifies the files of the incremental session directory.
+            let mmap = unsafe { Mmap::map(file) }
+                .unwrap_or_else(|err| tcx.dcx().emit_fatal(FailCreateFileEncoder { err }));
+            let blob = MetadataBlob::new(slice_owned(mmap, Deref::deref))
+                .expect("saved metadata has a valid header");
+            let hashes = blob.get_header().hashes;
+            with_encode_metadata_header::<DefIndexDefIdEncoder>(tcx, ref_path, |ecx| {
+                let header: LazyValue<CrateHeader> = ecx.lazy(CrateHeader {
+                    name: tcx.crate_name(LOCAL_CRATE),
+                    triple: tcx.sess.opts.target_triple.clone(),
+                    hashes,
+                    is_proc_macro_crate: false,
+                    is_stub: true,
+                });
+                header.position.get()
+            })
+        }
         return;
     };
 
diff --git a/tests/run-make/metadata-stub-incremental-reuse/foo.rs b/tests/run-make/metadata-stub-incremental-reuse/foo.rs
new file mode 100644
index 000000000..7bc926791
--- /dev/null
+++ b/tests/run-make/metadata-stub-incremental-reuse/foo.rs
@@ -0,0 +1,3 @@
