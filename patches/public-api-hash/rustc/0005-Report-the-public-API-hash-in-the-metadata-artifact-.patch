+/// Reads the public API hash from the header of the metadata file at `path`.
+fn read_public_api_hash(path: &Path) -> Option<String> {
+    let file = fs::File::open(path).ok()?;
+    // SAFETY: this session has just written the file, and nothing modifies it.
+    let mmap = unsafe { Mmap::map(file) }.ok()?;
+    let blob = MetadataBlob::new(slice_owned(mmap, Deref::deref)).ok()?;
+    Some(blob.get_header().hashes.public_hash.to_string())
+}
