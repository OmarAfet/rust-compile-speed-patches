+//@ needs-target-std
+//
+// With `-Zpublic-api-hash`, the artifact notification of the metadata file reports the crate's
+// public API hash, so that build systems can read it without parsing the metadata. It must be the
+// hash in the metadata, also when incremental compilation reuses the saved metadata, and it is not
+// reported without the flag.
+
+use run_make_support::{cwd, rustc};
+
+/// Compiles `lib.rs` and returns the `public_hash` of its metadata artifact notification.
+fn compile(public_api_hash: bool) -> Option<String> {
+    let mut cmd = rustc();
+    cmd.input("lib.rs")
+        .crate_type("rlib")
+        .emit("metadata,link")
+        .json("artifacts")
+        .error_format("json")
+        .incremental(cwd().join("incr"));
+    if public_api_hash {
+        cmd.arg("-Zpublic-api-hash");
+    }
+    let stderr = cmd.run().stderr_utf8();
+    let notification = stderr
+        .lines()
+        .find(|line| line.contains(r#""emit":"metadata""#))
+        .expect("no artifact notification for the metadata");
+    let (_, rest) = notification.split_once(r#""public_hash":""#)?;
+    Some(rest.split('"').next().unwrap().to_owned())
+}
+
+fn public_hash_in_metadata() -> String {
+    let listing = rustc().arg("-Zls=public_hash").input("liblib.rmeta").run().stdout_utf8();
+    listing
+        .lines()
+        .find_map(|line| line.strip_prefix("Public hash:"))
+        .map(|hash| hash.trim().to_owned())
+        .expect("`-Zls=public_hash` did not print a `Public hash:` line")
+}
+
+fn main() {
+    assert_eq!(compile(false), None, "public hash reported without `-Zpublic-api-hash`");
+
+    let reported = compile(true).expect("no public hash in the notification");
+    assert_eq!(reported, public_hash_in_metadata());
+
+    // Unchanged sources: the metadata is reused from the incremental session directory.
+    let reused = compile(true).expect("no public hash in the notification of reused metadata");
+    assert_eq!(reused, reported);
+}
