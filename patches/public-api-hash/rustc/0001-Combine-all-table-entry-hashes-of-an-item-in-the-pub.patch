@@ -0,0 +1,48 @@
+// Changing what downstream crates can see of a public item, such as the value of a constant or
+// static, or a deprecation note, must change the crate's *public API hash*. The hash of an item
+// combines the hashes of all its metadata table entries, so a change in any one of them must reach
+// it.
+//
+// Like `rdr-public-hash-moved-items`, this test rewrites the source file between compilations:
+// the incremental `rdr` tests switch values with `cfg` attributes, which change the hash by
+// themselves.
+
+//@ ignore-cross-compile
+
+use run_make_support::{rfs, rustc};
+
+/// Compile `dep.rs` (and its module `m.rs`) with public api hashing, and return its public hash.
+fn compile_and_read_public_hash() -> String {
+    rustc().input("dep.rs").edition("2024").arg("-Zpublic-api-hash").run();
+    let listing = rustc().arg("-Zls=public_hash").input("libdep.rlib").run().stdout_utf8();
+    listing
+        .lines()
+        .find_map(|line| line.strip_prefix("Public hash:"))
+        .map(|hash| hash.trim().to_owned())
+        .expect("`-Zls=public_hash` did not print a `Public hash:` line")
+}
+
+/// The items are in a module file: there, the changed table entries are not the last ones encoded
+/// for their items.
+fn replace(from: &str, to: &str) {
+    let contents = rfs::read_to_string("m.rs");
+    assert!(contents.contains(from), "`{from}` not found");
+    rfs::write("m.rs", contents.replace(from, to));
+}
+
+fn main() {
+    let baseline = compile_and_read_public_hash();
+
+    replace("pub const C: u32 = 5;", "pub const C: u32 = 6;");
+    let after_const = compile_and_read_public_hash();
+    assert_ne!(baseline, after_const, "public hash did not change with the value of `C`");
+
+    replace("pub static S: u32 = 5;", "pub static S: u32 = 6;");
+    let after_static = compile_and_read_public_hash();
+    assert_ne!(after_const, after_static, "public hash did not change with the value of `S`");
+
+    // Only one table entry of `old` changes, and not the last one encoded for it.
+    replace("first note", "second note");
+    let after_note = compile_and_read_public_hash();
+    assert_ne!(after_static, after_note, "public hash did not change with the deprecation note");
+}
